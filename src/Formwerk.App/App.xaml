<Application x:Class="Formwerk.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="Dark">
    <Application.Resources>
        <!-- Palette from spec section 7: greys instead of black, one accent colour. -->
        <SolidColorBrush x:Key="WindowBrush" Color="#1E1F22" />
        <SolidColorBrush x:Key="PanelBrush" Color="#2B2D30" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#393B40" />
        <SolidColorBrush x:Key="TextBrush" Color="#DFE1E5" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#9DA0A8" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4C9AFF" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#F77067" />
    </Application.Resources>
</Application>
