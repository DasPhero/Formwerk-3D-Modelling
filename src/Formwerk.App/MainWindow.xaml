<Window x:Class="Formwerk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Formwerk.App.Resources"
        xmlns:vm="clr-namespace:Formwerk.App.ViewModels"
        xmlns:views="clr-namespace:Formwerk.App.Views"
        xmlns:vp="clr-namespace:Formwerk.Viewport;assembly=Formwerk.Viewport"
        xmlns:core="clr-namespace:Formwerk.Core.Model;assembly=Formwerk.Core"
        Title="{Binding WindowTitle}" AllowDrop="True" Width="1440" Height="880" MinWidth="900" MinHeight="560"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d"
        PreviewKeyDown="OnPreviewKeyDown" KeyDown="OnKeyDown" Activated="OnActivated" DragOver="OnDragOver" Drop="OnDrop">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewCommand}" />
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding ImportCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveProjectAsCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding DuplicateCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}" />
        <KeyBinding Key="V" Modifiers="Ctrl" Command="{Binding PasteCommand}" />
        <KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding GroupCommand}" />
        <KeyBinding Key="G" Modifiers="Ctrl+Shift" Command="{Binding UngroupCommand}" />
        <KeyBinding Key="M" Modifiers="Ctrl" Command="{Binding MergeCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding ExportStlCommand}" />
        <KeyBinding Key="E" Modifiers="Ctrl+Shift" Command="{Binding Export3mfCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="PanelHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        </Style>

        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <!-- Numeric field: label, text box, unit. Red border when the input is invalid. -->
        <DataTemplate DataType="{x:Type vm:FieldViewModel}">
            <Grid Margin="0,2" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                         views:TextBoxBehavior.CommitOnEnter="True" ToolTip="{Binding Tip}">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                            <Style.Triggers>
                                <!-- linked to a project variable (F-PAR-03): accent border; an error comes after it and wins -->
                                <DataTrigger Binding="{Binding IsLinked}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
                <TextBlock Grid.Column="2" Text="{Binding Unit}" Margin="6,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </Grid>
        </DataTemplate>

        <!-- Text box of the variable table: red border on an error -->
        <Style x:Key="VariableBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="ToolTip" Value="{Binding Tip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One variable: name = expression, delete, and below it the value (or the error) -->
        <DataTemplate DataType="{x:Type vm:VariableRowViewModel}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox DataContext="{Binding Name}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" Style="{StaticResource VariableBox}"
                         views:TextBoxBehavior.CommitOnEnter="True" AutomationProperties.AutomationId="VariableName" />
                <TextBlock Grid.Column="1" Text="=" Margin="6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBox Grid.Column="2" DataContext="{Binding Expression}" Text="{Binding Text, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource VariableBox}" views:TextBoxBehavior.CommitOnEnter="True"
                         AutomationProperties.AutomationId="VariableExpression" />
                <Button Grid.Column="3" Content="✕" ToolTip="{res:Loc Var.Delete.Tip}" Command="{Binding DeleteCommand}" Margin="6,0,0,0" MinWidth="0"
                        Padding="8,2" VerticalAlignment="Center" AutomationProperties.AutomationId="VariableDelete" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="4" Text="{Binding ValueText, StringFormat='= {0}'}" FontSize="11" Margin="2,2,0,0"
                           TextWrapping="Wrap" AutomationProperties.AutomationId="VariableValue">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasValueError}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!-- Cross-section picture of a hole: the body cut open with the hole in it (F-HOL-02) -->
        <DataTemplate DataType="{x:Type vm:HoleSection}">
            <Border BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="HoleSection">
                <Canvas Width="140" Height="90">
                    <Path Data="{Binding Body}" Fill="{DynamicResource MutedTextBrush}" Opacity="0.4" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1" />
                    <Path Data="{Binding Hole}" Fill="{DynamicResource PanelBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.4" StrokeLineJoin="Round" />
                    <Path Data="{Binding Axis}" Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="0.8" StrokeDashArray="3 3" />
                </Canvas>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NodeItemViewModel}">
            <StackPanel Orientation="Horizontal">
                <Border Width="{Binding Indent}" />
                <CheckBox IsChecked="{Binding Visible}" ToolTip="{res:Loc Tip.Visible}" MinWidth="0" Padding="0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Glyph}" Margin="4,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text=" ◌" ToolTip="{res:Loc Tip.Hole}" Foreground="#FF8A5C" VerticalAlignment="Center"
                           Visibility="{Binding IsHole, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text=" ⚠" ToolTip="{Binding ErrorText}" Foreground="{DynamicResource ErrorBrush}" VerticalAlignment="Center"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PropertiesViewModel}">
            <StackPanel>
                <ContentControl Content="{Binding NameField}" />
                <CheckBox Content="{res:Loc Props.Hole}" IsChecked="{Binding IsHole}" Margin="0,8,0,0" />

                <StackPanel Visibility="{Binding IsBoolean, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                    <TextBlock Text="{res:Loc Props.Operation}" Style="{StaticResource PanelHeader}" />
                    <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}" />
                </StackPanel>

                <TextBlock Text="{res:Loc Props.Position}" Style="{StaticResource PanelHeader}" Margin="0,14,0,6" />
                <ItemsControl ItemsSource="{Binding Position}" />

                <TextBlock Text="{res:Loc Props.Rotation}" Style="{StaticResource PanelHeader}" Margin="0,14,0,6" />
                <ItemsControl ItemsSource="{Binding Rotation}" />

                <StackPanel Visibility="{Binding HasParameters, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{res:Loc Props.Parameters}" Style="{StaticResource PanelHeader}" Margin="0,14,0,6" />
                    <StackPanel Visibility="{Binding IsHoleShape, Converter={StaticResource BoolToVisibility}}">
                        <ComboBox ItemsSource="{Binding HoleTypes}" DisplayMemberPath="Label" SelectedValuePath="Type" SelectedValue="{Binding HoleType}"
                                  Margin="0,0,0,6" AutomationProperties.AutomationId="PropertiesHoleType" />
                        <ContentControl Content="{Binding Section}" Margin="0,0,0,6" />
                        <CheckBox Content="{res:Loc Hole.Through}" ToolTip="{res:Loc Hole.Through.Tip}" IsChecked="{Binding HoleThrough}" Margin="0,2,0,4"
                                  AutomationProperties.AutomationId="PropertiesHoleThrough" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Parameters}" />
                    <!-- Chamfer and fillet (F-EDG-01): the size is a field above, type and position are choices -->
                    <StackPanel Visibility="{Binding HasEdgeChoices, Converter={StaticResource BoolToVisibility}}" Margin="0,2,0,0">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{res:Loc Edge.Type}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding EdgeTypes}" DisplayMemberPath="Label" SelectedValuePath="Index"
                                      SelectedValue="{Binding EdgeType}" AutomationProperties.AutomationId="EdgeType" />
                        </Grid>
                        <Grid Margin="0,2" Visibility="{Binding HasEdgeWhere, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{res:Loc Edge.Where}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding EdgeWheres}" DisplayMemberPath="Label" SelectedValuePath="Index"
                                      SelectedValue="{Binding EdgeWhere}" AutomationProperties.AutomationId="EdgeWhere" />
                        </Grid>
                    </StackPanel>
                    <!-- Mirror (F-PAT-04): the plane and whether the original stays -->
                    <StackPanel Visibility="{Binding IsMirror, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                        <Grid Margin="0,2" ToolTip="{res:Loc Mirror.Axis.Tip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{res:Loc Mirror.Axis}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PatternAxes}" DisplayMemberPath="Label" SelectedValuePath="Index"
                                      SelectedValue="{Binding MirrorAxis}" AutomationProperties.AutomationId="MirrorAxis" />
                        </Grid>
                        <CheckBox Content="{res:Loc Mirror.ShowOriginal}" ToolTip="{res:Loc Mirror.ShowOriginal.Tip}" IsChecked="{Binding MirrorShowOriginal}"
                                  Margin="0,4,0,4" AutomationProperties.AutomationId="MirrorShowOriginal" />
                    </StackPanel>
                    <!-- Pattern (F-PAT-01..03): directions, total length, skipped instances -->
                    <StackPanel Visibility="{Binding IsPattern, Converter={StaticResource BoolToVisibility}}" Margin="0,6,0,0">
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding PatternAxisLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding PatternAxes}" DisplayMemberPath="Label" SelectedValuePath="Index"
                                      SelectedValue="{Binding PatternAxis}" AutomationProperties.AutomationId="PatternAxis" />
                        </Grid>
                        <StackPanel Visibility="{Binding IsLinearPattern, Converter={StaticResource BoolToVisibility}}">
                            <CheckBox Content="{res:Loc Pattern.TotalLength}" IsChecked="{Binding PatternTotalLength}" Margin="0,4,0,4" />
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="86" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{res:Loc Pattern.DirectionY}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <ComboBox Grid.Column="1" ItemsSource="{Binding PatternAxes}" DisplayMemberPath="Label" SelectedValuePath="Index"
                                          SelectedValue="{Binding PatternAxisY}" AutomationProperties.AutomationId="PatternAxisY" />
                            </Grid>
                            <CheckBox Content="{res:Loc Pattern.TotalLengthY}" IsChecked="{Binding PatternTotalLengthY}" Margin="0,4,0,4" />
                        </StackPanel>
                        <!-- Circular pattern: radius and distance from the outer edge (F-PAT-01) -->
                        <StackPanel Visibility="{Binding IsCircularPattern, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,0">
                            <ContentControl Content="{Binding RadiusField}" ToolTip="{res:Loc Pattern.Radius.Tip}" AutomationProperties.AutomationId="PatternRadius" />
                            <StackPanel Visibility="{Binding HasEdgeReference, Converter={StaticResource BoolToVisibility}}">
                                <ContentControl Content="{Binding EdgeDistanceField}" ToolTip="{res:Loc Pattern.EdgeDistance.Tip}"
                                                AutomationProperties.AutomationId="PatternEdgeDistance" />
                                <CheckBox Content="{res:Loc Pattern.EdgeToHoleEdge}" IsChecked="{Binding EdgeToHoleEdge}" Margin="0,4,0,4" />
                            </StackPanel>
                        </StackPanel>
                        <ContentControl Content="{Binding SkipField}" ToolTip="{res:Loc Pattern.Skip.Tip}" AutomationProperties.AutomationId="PatternSkip" />
                        <TextBlock Text="{Binding InstanceText}" Margin="0,6,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   AutomationProperties.AutomationId="PatternInstances" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{res:Loc Props.Size}" Style="{StaticResource PanelHeader}" Margin="0,14,0,2" />
                <TextBlock Text="{Binding SizeText}" />

                <TextBlock Text="{res:Loc Props.InputHint}" TextWrapping="Wrap" Margin="0,16,0,0"
                           Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{res:Loc Menu.File}">
                <MenuItem Header="{res:Loc Menu.File.New}" Command="{Binding NewCommand}" InputGestureText="Ctrl+N" />
                <MenuItem Header="{res:Loc Menu.File.Open}" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="{res:Loc Menu.File.Save}" Command="{Binding SaveProjectCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="{res:Loc Menu.File.SaveAs}" Command="{Binding SaveProjectAsCommand}" InputGestureText="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{res:Loc Menu.File.Import}" Command="{Binding ImportCommand}" InputGestureText="Ctrl+I" />
                <MenuItem Header="{res:Loc Menu.File.ExportStl}" Command="{Binding ExportStlCommand}" InputGestureText="Ctrl+E" />
                <MenuItem Header="{res:Loc Menu.File.Export3mf}" Command="{Binding Export3mfCommand}" InputGestureText="Ctrl+Shift+E" />
                <MenuItem Header="{res:Loc Menu.File.ExportObj}" Command="{Binding ExportObjCommand}" />
                <MenuItem Header="{res:Loc Menu.File.OpenInSlicer}" Command="{Binding OpenInSlicerCommand}" />
                <Separator />
                <MenuItem Header="{res:Loc Menu.File.Settings}" Command="{Binding OpenSettingsCommand}" InputGestureText="Ctrl+," />
                <Separator />
                <MenuItem Header="{res:Loc Menu.File.Exit}" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="{res:Loc Menu.Edit}">
                <MenuItem Header="{res:Loc Menu.Edit.Undo}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="{res:Loc Menu.Edit.Redo}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="{res:Loc Menu.Edit.Copy}" Command="{Binding CopyCommand}" InputGestureText="Ctrl+C" />
                <MenuItem Header="{res:Loc Menu.Edit.Paste}" Command="{Binding PasteCommand}" InputGestureText="Ctrl+V" />
                <MenuItem Header="{res:Loc Menu.Edit.Duplicate}" Command="{Binding DuplicateCommand}" InputGestureText="Ctrl+D" />
                <MenuItem Header="{res:Loc Menu.Edit.Delete}" Command="{Binding DeleteCommand}" InputGestureText="Del" />
                <Separator />
                <MenuItem Header="{res:Loc Menu.Edit.Group}" Command="{Binding GroupCommand}" InputGestureText="Ctrl+G" />
                <MenuItem Header="{res:Loc Menu.Edit.Ungroup}" Command="{Binding UngroupCommand}" InputGestureText="Ctrl+Shift+G" />
                <MenuItem Header="{res:Loc Menu.Edit.Merge}" Command="{Binding MergeCommand}" InputGestureText="Ctrl+M" />
                <MenuItem Header="{res:Loc Menu.Edit.Flatten}" Command="{Binding FlattenCommand}" />
                <MenuItem Header="{res:Loc Menu.Edit.Cut}" Command="{Binding CutCommand}" ToolTip="{res:Loc Menu.Edit.Cut.Tip}" />
                <MenuItem Header="{res:Loc Menu.Edit.Split}" Command="{Binding SplitPartsCommand}" ToolTip="{res:Loc Menu.Edit.Split.Tip}" />
                <MenuItem Header="{res:Loc Menu.Edit.DropToFloor}" Command="{Binding DropToFloorCommand}" InputGestureText="B" />
                <MenuItem Header="{res:Loc Menu.Edit.FaceOnFloor}" Command="{Binding FaceOnFloorCommand}" />
                <MenuItem Header="{res:Loc Menu.Edit.FaceToFace}" Command="{Binding FaceToFaceCommand}" />
                <MenuItem Header="{res:Loc Menu.Edit.Drill}" Command="{Binding DrillCommand}" />
                <MenuItem Header="{res:Loc Menu.Edit.EdgeCut}" Command="{Binding EdgeCutCommand}" />
                <MenuItem Header="{res:Loc Menu.Edit.Measure}" Command="{Binding MeasureCommand}" />
                <MenuItem Header="{res:Loc Menu.Edit.Pattern}">
                    <MenuItem Header="{res:Loc Menu.Edit.Pattern.Linear}" Command="{Binding LinearPatternCommand}" />
                    <MenuItem Header="{res:Loc Menu.Edit.Pattern.Circular}" Command="{Binding CircularPatternCommand}" />
                </MenuItem>
                <MenuItem Header="{res:Loc Menu.Edit.Align}">
                    <MenuItem Header="{res:Loc Menu.Edit.Align.XMin}" Command="{Binding AlignCommand}" CommandParameter="X-Min" />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.XCenter}" Command="{Binding AlignCommand}" CommandParameter="X-Center" />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.XMax}" Command="{Binding AlignCommand}" CommandParameter="X-Max" />
                    <Separator />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.YMin}" Command="{Binding AlignCommand}" CommandParameter="Y-Min" />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.YCenter}" Command="{Binding AlignCommand}" CommandParameter="Y-Center" />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.YMax}" Command="{Binding AlignCommand}" CommandParameter="Y-Max" />
                    <Separator />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.ZMin}" Command="{Binding AlignCommand}" CommandParameter="Z-Min" />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.ZCenter}" Command="{Binding AlignCommand}" CommandParameter="Z-Center" />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.ZMax}" Command="{Binding AlignCommand}" CommandParameter="Z-Max" />
                    <Separator />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.DistributeX}" Command="{Binding DistributeCommand}" CommandParameter="X" />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.DistributeY}" Command="{Binding DistributeCommand}" CommandParameter="Y" />
                    <MenuItem Header="{res:Loc Menu.Edit.Align.DistributeZ}" Command="{Binding DistributeCommand}" CommandParameter="Z" />
                </MenuItem>
                <MenuItem Header="{res:Loc Menu.Edit.Mirror}">
                    <MenuItem Header="{res:Loc Menu.Edit.Mirror.Linked}" Command="{Binding LinkedMirrorCommand}" />
                    <MenuItem Header="{res:Loc Menu.Edit.Mirror.Copy}" Command="{Binding MirroredCopyCommand}" />
                    <Separator />
                    <MenuItem Header="{res:Loc Menu.Edit.Mirror.LinkedFace}" Command="{Binding LinkedMirrorAtFaceCommand}" />
                    <MenuItem Header="{res:Loc Menu.Edit.Mirror.CopyFace}" Command="{Binding MirroredCopyAtFaceCommand}" />
                </MenuItem>
                <MenuItem Header="{res:Loc Menu.Edit.Rotate90}">
                    <MenuItem Header="{res:Loc Rot.XPlus}" Command="{Binding Rotate90Command}" CommandParameter="X" />
                    <MenuItem Header="{res:Loc Rot.XMinus}" Command="{Binding Rotate90Command}" CommandParameter="-X" />
                    <MenuItem Header="{res:Loc Rot.YPlus}" Command="{Binding Rotate90Command}" CommandParameter="Y" />
                    <MenuItem Header="{res:Loc Rot.YMinus}" Command="{Binding Rotate90Command}" CommandParameter="-Y" />
                    <MenuItem Header="{res:Loc Rot.ZPlus}" Command="{Binding Rotate90Command}" CommandParameter="Z" />
                    <MenuItem Header="{res:Loc Rot.ZMinus}" Command="{Binding Rotate90Command}" CommandParameter="-Z" />
                </MenuItem>
                <MenuItem Header="{res:Loc Menu.Edit.ToggleHole}" Command="{Binding ToggleHoleCommand}" InputGestureText="H" />
                <MenuItem Header="{res:Loc Menu.Edit.Boolean}">
                    <MenuItem Header="{res:Loc Menu.Edit.Union}" Command="{Binding BooleanCommand}"
                              CommandParameter="{x:Static core:BooleanOperation.Union}" />
                    <MenuItem Header="{res:Loc Menu.Edit.Difference}" Command="{Binding BooleanCommand}"
                              CommandParameter="{x:Static core:BooleanOperation.Difference}" />
                    <MenuItem Header="{res:Loc Menu.Edit.Intersection}" Command="{Binding BooleanCommand}"
                              CommandParameter="{x:Static core:BooleanOperation.Intersection}" />
                </MenuItem>
                <Separator />
                <MenuItem Header="{res:Loc Menu.Edit.SaveTemplate}" Command="{Binding SaveTemplateCommand}" />
                <MenuItem Header="{res:Loc Menu.Edit.UpdateTemplate}" Command="{Binding UpdateTemplateCommand}" />
            </MenuItem>
            <MenuItem Header="{res:Loc Menu.View}">
                <MenuItem Header="{res:Loc Menu.View.Frame}" Command="{Binding FrameSelectionCommand}" InputGestureText="F" />
                <Separator />
                <MenuItem Header="{res:Loc Menu.View.Front}" Command="{Binding SetViewCommand}" CommandParameter="{x:Static vp:ViewPreset.Front}" InputGestureText="1" />
                <MenuItem Header="{res:Loc Menu.View.Back}" Command="{Binding SetViewCommand}" CommandParameter="{x:Static vp:ViewPreset.Back}" InputGestureText="2" />
                <MenuItem Header="{res:Loc Menu.View.Left}" Command="{Binding SetViewCommand}" CommandParameter="{x:Static vp:ViewPreset.Left}" InputGestureText="3" />
                <MenuItem Header="{res:Loc Menu.View.Right}" Command="{Binding SetViewCommand}" CommandParameter="{x:Static vp:ViewPreset.Right}" InputGestureText="4" />
                <MenuItem Header="{res:Loc Menu.View.Top}" Command="{Binding SetViewCommand}" CommandParameter="{x:Static vp:ViewPreset.Top}" InputGestureText="5" />
                <MenuItem Header="{res:Loc Menu.View.Bottom}" Command="{Binding SetViewCommand}" CommandParameter="{x:Static vp:ViewPreset.Bottom}" InputGestureText="6" />
                <MenuItem Header="{res:Loc Menu.View.Isometric}" Command="{Binding SetViewCommand}" CommandParameter="{x:Static vp:ViewPreset.Isometric}" InputGestureText="7" />
                <Separator />
                <MenuItem Header="{res:Loc Menu.View.Orthographic}" IsCheckable="True" IsChecked="{Binding IsOrthographic, Mode=TwoWay}" InputGestureText="P" />
                <MenuItem Header="{res:Loc Menu.View.ShowHoles}" IsCheckable="True" IsChecked="{Binding ShowHoles, Mode=TwoWay}" />
                <MenuItem Header="{res:Loc Menu.View.Section}" IsCheckable="True" IsChecked="{Binding IsSectionActive, Mode=TwoWay}" />
                <MenuItem Header="{res:Loc Menu.View.LightTheme}" IsCheckable="True" IsChecked="{Binding LightTheme, Mode=TwoWay}" />
                <MenuItem Header="{res:Loc Menu.View.Display}" InputGestureText="Z">
                    <MenuItem Header="{res:Loc Display.Shaded}" IsCheckable="True" IsChecked="{Binding IsShadedMode, Mode=TwoWay}" />
                    <MenuItem Header="{res:Loc Display.ShadedEdges}" IsCheckable="True" IsChecked="{Binding IsShadedWithEdgesMode, Mode=TwoWay}" />
                    <MenuItem Header="{res:Loc Display.Wireframe}" IsCheckable="True" IsChecked="{Binding IsWireframeMode, Mode=TwoWay}" />
                    <MenuItem Header="{res:Loc Display.XRay}" IsCheckable="True" IsChecked="{Binding IsXRayMode, Mode=TwoWay}" />
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Tool bar: select / move / rotate and drop to floor -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <ToggleButton Content="{res:Loc Tool.Select}" ToolTip="{res:Loc Tool.Select.Tip}" IsChecked="{Binding IsSelectTool}" MinWidth="70" Margin="0,0,4,0" />
                <ToggleButton Content="{res:Loc Tool.Move}" ToolTip="{res:Loc Tool.Move.Tip}" IsChecked="{Binding IsMoveTool}" MinWidth="70" Margin="0,0,4,0" />
                <ToggleButton Content="{res:Loc Tool.Rotate}" ToolTip="{res:Loc Tool.Rotate.Tip}" IsChecked="{Binding IsRotateTool}" MinWidth="70" Margin="0,0,4,0" />
                <ToggleButton Content="{res:Loc Tool.Scale}" ToolTip="{res:Loc Tool.Scale.Tip}" IsChecked="{Binding IsScaleTool}" MinWidth="70" Margin="0,0,8,0" />
                <CheckBox Content="{res:Loc Tool.Proportional}" ToolTip="{res:Loc Tool.Proportional.Tip}" IsChecked="{Binding ScaleLinked}" MinWidth="0" Margin="0,0,16,0" />
                <Button Content="{res:Loc Tool.DropToFloor}" ToolTip="{res:Loc Tool.DropToFloor.Tip}" Command="{Binding DropToFloorCommand}" />
                <Button Content="{res:Loc Tool.FaceOnFloor}" ToolTip="{res:Loc Tool.FaceOnFloor.Tip}" Command="{Binding FaceOnFloorCommand}" Margin="6,0,0,0" />
                <ToggleButton Content="{res:Loc Tool.FaceToFace}" ToolTip="{res:Loc Tool.FaceToFace.Tip}" Command="{Binding FaceToFaceCommand}"
                              IsChecked="{Binding IsPickingFaceToFace, Mode=OneWay}" Margin="6,0,0,0" AutomationProperties.AutomationId="FaceToFaceButton" />
                <ToggleButton Content="{res:Loc Tool.Hole}" ToolTip="{res:Loc Tool.Hole.Tip}" Command="{Binding DrillCommand}"
                              IsChecked="{Binding IsPlacingHole, Mode=OneWay}" Margin="14,0,0,0" AutomationProperties.AutomationId="DrillButton" />
                <ToggleButton Content="{res:Loc Tool.EdgeCut}" ToolTip="{res:Loc Tool.EdgeCut.Tip}" Command="{Binding EdgeCutCommand}"
                              IsChecked="{Binding IsPlacingEdgeCut, Mode=OneWay}" Margin="6,0,0,0" AutomationProperties.AutomationId="EdgeCutButton" />
                <ToggleButton Content="{res:Loc Tool.Measure}" ToolTip="{res:Loc Tool.Measure.Tip}" Command="{Binding MeasureCommand}"
                              IsChecked="{Binding IsMeasuring, Mode=OneWay}" Margin="6,0,0,0" AutomationProperties.AutomationId="MeasureButton" />
            </StackPanel>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}">
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="{res:Loc Floor.Keep}" ToolTip="{res:Loc Floor.Keep.Tip}" IsChecked="{Binding AlwaysOnFloor}" MinWidth="0" Margin="0,0,16,0" />
                    <CheckBox Content="{res:Loc Snap.Objects}" ToolTip="{res:Loc Snap.Objects.Tip}" IsChecked="{Binding SnapToObjects}" MinWidth="0" Margin="0,0,16,0" />
                    <CheckBox Content="{res:Loc Snap.Grid}" ToolTip="{res:Loc Snap.Grid.Tip}" IsChecked="{Binding SnapToGrid}" MinWidth="0" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding GridSteps}" SelectedItem="{Binding GridStep}" ToolTip="{res:Loc Snap.Grid.Tip}" MinWidth="64" Margin="0,0,16,0" />
                    <CheckBox Content="{res:Loc Snap.Angle}" ToolTip="{res:Loc Snap.Angle.Tip}" IsChecked="{Binding SnapAngles}" MinWidth="0" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding AngleSteps}" SelectedItem="{Binding AngleStep}" ToolTip="{res:Loc Snap.Angle.Tip}" MinWidth="58" Margin="0,0,20,0" />
                    <ProgressBar IsIndeterminate="True" Width="70" Height="6" Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusText}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="HintLine" Text="{Binding HintText}" ToolTip="{Binding HintText}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource MutedTextBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="160" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="300" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <!-- Left: shapes, objects, history -->
            <Border Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="6" />
                        <RowDefinition Height="160" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="{res:Loc Panel.Shapes}" Style="{StaticResource PanelHeader}" />
                        <ItemsControl ItemsSource="{Binding Shapes}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ShapeEntryViewModel}">
                                    <Button Content="{Binding DisplayName}" Margin="0,0,6,6" MinWidth="64"
                                            Command="{Binding DataContext.AddShapeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Id}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="{res:Loc Tpl.Import}" Padding="8,2" Margin="0,8,0,0" VerticalAlignment="Bottom"
                                    Command="{Binding ImportTemplateCommand}" ToolTip="{res:Loc Tpl.ImportTip}" AutomationProperties.AutomationId="ImportTemplate" />
                            <TextBlock Text="{res:Loc Panel.Templates}" Style="{StaticResource PanelHeader}" />
                        </DockPanel>
                        <TextBlock Text="{res:Loc Panel.Templates.Empty}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Templates.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
                            <ItemsControl ItemsSource="{Binding Templates}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TemplateItemViewModel}">
                                        <Button Margin="0,0,0,4" HorizontalContentAlignment="Stretch" ToolTip="{Binding Tooltip}"
                                                Command="{Binding DataContext.InsertTemplateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{res:Loc Tpl.Edit}" Command="{Binding EditCommand}" />
                                                    <MenuItem Header="{res:Loc Tpl.Duplicate}" Command="{Binding DuplicateCommand}" />
                                                    <MenuItem Header="{res:Loc Tpl.Export}" Command="{Binding ExportCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="{res:Loc Tpl.Delete}" Command="{Binding DeleteCommand}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <DockPanel LastChildFill="True">
                                                <Image DockPanel.Dock="Left" Source="{Binding PreviewPng}" Width="40" Height="40" Margin="0,0,8,0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <DockPanel Grid.Row="1">
                        <TextBlock DockPanel.Dock="Top" Text="{res:Loc Panel.Objects}" Style="{StaticResource PanelHeader}" />
                        <ListBox ItemsSource="{Binding Nodes}" SelectionMode="Extended" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Row="3">
                        <TextBlock DockPanel.Dock="Top" Text="{res:Loc Panel.History}" Style="{StaticResource PanelHeader}" />
                        <ListBox ItemsSource="{Binding HistoryEntries}" SelectedIndex="{Binding HistorySelectedIndex, Mode=TwoWay}"
                                 Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:HistoryEntryViewModel}">
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFuture}" Value="True">
                                                        <Setter Property="Opacity" Value="0.45" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Center: 3D view -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                <Grid>
                <vp:ViewportControl x:Name="Viewport"
                                    Items="{Binding ViewportItems}"
                                    SelectedIds="{Binding SelectedIds}"
                                    BuildVolume="{Binding BuildVolume}"
                                    PickCommand="{Binding PickCommand}"
                                    MarqueeCommand="{Binding MarqueeCommand}"
                                    OpenGroupCommand="{Binding OpenGroupCommand}"
                                    ActiveTool="{Binding ActiveTool}"
                                    PreviewTransforms="{Binding PreviewTransforms}"
                                    FacePickMode="{Binding IsFacePickActive}"
                                    FacePickCommand="{Binding FacePickedCommand}"
                                    FaceHoverCommand="{Binding FaceHoveredCommand}"
                                    EdgeHighlight="{Binding EdgeHighlight}"
                                    Measurements="{Binding ViewportMeasurements}"
                                    Orthographic="{Binding IsOrthographic}"
                                    LightTheme="{Binding LightTheme}"
                                    ViewCubeLabels="{Binding ViewCubeLabels}"
                                    DisplayMode="{Binding DisplayMode}"
                                    EdgeAngle="{Binding EdgeAngle}"
                                    GizmoPivot="{Binding GizmoPivot}"
                                    ScaleBox="{Binding GizmoScaleBox}"
                                    SnapGuides="{Binding SnapGuides}"
                                    SnapMarkers="{Binding SnapMarkers}"
                                    Dimensions="{Binding ViewportDimensions}"
                                    DimensionCommand="{Binding EditDimensionCommand}"
                                    GizmoTarget="{Binding GizmoTargetObject}" />

                <!-- Mesh check: what is wrong with the selected imported meshes, and the one-click repair (F-IMP-03) -->
                <Border VerticalAlignment="Top" Margin="12" Padding="10,6" CornerRadius="4" BorderThickness="1"
                        BorderBrush="#B8860B" Background="#E6302A1A"
                        Visibility="{Binding IsRepairBannerVisible, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="{res:Loc Repair.Button}" ToolTip="{res:Loc Repair.Tip}"
                                Command="{Binding RepairMeshCommand}" Margin="12,0,0,0" MinWidth="80" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="RepairButton" />
                        <TextBlock Text="{Binding RepairBannerText}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Foreground="#F2D98A" AutomationProperties.AutomationId="RepairBanner" />
                    </DockPanel>
                </Border>

                <!-- Face to face (F-SNP-03): the gap between the two faces -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10" Width="240" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource PanelBrush}"
                        Visibility="{Binding IsPickingFaceToFace, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="FaceToFacePanel">
                    <StackPanel>
                        <TextBlock Text="{res:Loc FaceToFace.Title}" Style="{StaticResource PanelHeader}" Margin="0,0,0,6" />
                        <ContentControl Content="{Binding FaceGap}" ToolTip="{res:Loc FaceToFace.Gap.Tip}" AutomationProperties.AutomationId="FaceGap" />
                    </StackPanel>
                </Border>

                <!-- Hole tool: what the next hole looks like (F-HOL-01, F-HOL-02) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10" Width="260" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource PanelBrush}"
                        Visibility="{Binding IsPlacingHole, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="HolePanel">
                    <StackPanel DataContext="{Binding HoleTool}">
                        <TextBlock Text="{res:Loc Hole.Title}" Style="{StaticResource PanelHeader}" Margin="0,0,0,6" />
                        <!-- Screw presets (F-HOL-03): a size and what the hole is for fill in the rest -->
                        <Grid Margin="0,0,0,6" ToolTip="{res:Loc Hole.Preset.Tip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{res:Loc Hole.Preset.Screw}" VerticalAlignment="Center" Margin="0,0,10,4" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ScrewChoices}" DisplayMemberPath="Label" SelectedValuePath="Key"
                                      SelectedValue="{Binding PresetSize}" Margin="0,0,0,4" AutomationProperties.AutomationId="HoleScrew" />
                            <TextBlock Grid.Row="1" Text="{res:Loc Hole.Preset.For}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding PresetKinds}" DisplayMemberPath="Label" SelectedValuePath="Kind"
                                      SelectedValue="{Binding PresetKind}" IsEnabled="{Binding HasPreset}" AutomationProperties.AutomationId="HoleKind" />
                        </Grid>
                        <ComboBox ItemsSource="{Binding Types}" DisplayMemberPath="Label" SelectedValuePath="Type" SelectedValue="{Binding Type}"
                                  Margin="0,0,0,6" AutomationProperties.AutomationId="HoleType" />
                        <ContentControl Content="{Binding Section}" Margin="0,0,0,6" />
                        <ContentControl Content="{Binding Diameter}" />
                        <ContentControl Content="{Binding EndDiameter}" Visibility="{Binding ShowEndDiameter, Converter={StaticResource BoolToVisibility}}" />
                        <ContentControl Content="{Binding HeadDiameter}" Visibility="{Binding ShowHead, Converter={StaticResource BoolToVisibility}}" />
                        <ContentControl Content="{Binding HeadAngle}" Visibility="{Binding ShowHeadAngle, Converter={StaticResource BoolToVisibility}}" />
                        <ContentControl Content="{Binding HeadDepth}" Visibility="{Binding ShowHeadDepth, Converter={StaticResource BoolToVisibility}}" />
                        <CheckBox Content="{res:Loc Hole.Through}" ToolTip="{res:Loc Hole.Through.Tip}" IsChecked="{Binding Through}" Margin="0,6,0,2" />
                        <ContentControl Content="{Binding Depth}" Visibility="{Binding ShowDepth, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Border>

                <!-- Section view (E-06): plane, position, side -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10" Width="260" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource PanelBrush}"
                        Visibility="{Binding IsSectionActive, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="SectionPanel">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="&#x2715;" Padding="6,0" Command="{Binding CloseSectionCommand}" ToolTip="{res:Loc Section.Close}"
                                    AutomationProperties.AutomationId="SectionClose" />
                            <TextBlock Text="{res:Loc Section.Title}" Style="{StaticResource PanelHeader}" />
                        </DockPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{res:Loc Section.Axis}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SectionAxes}" DisplayMemberPath="Label" SelectedValuePath="Index"
                                      SelectedValue="{Binding SectionAxis}" AutomationProperties.AutomationId="SectionAxis" />
                        </Grid>
                        <Slider Minimum="{Binding SectionMin}" Maximum="{Binding SectionMax}" Value="{Binding SectionPosition, Mode=TwoWay}"
                                Margin="0,0,0,4" AutomationProperties.AutomationId="SectionSlider" />
                        <ContentControl Content="{Binding SectionPositionField}" />
                        <CheckBox Content="{res:Loc Section.Flip}" IsChecked="{Binding SectionFlip}" Margin="0,6,0,0" AutomationProperties.AutomationId="SectionFlip" />
                        <WrapPanel Margin="0,8,0,0">
                            <ToggleButton Content="{res:Loc Section.PickFace}" ToolTip="{res:Loc Section.PickFace.Tip}" Command="{Binding SectionAtFaceCommand}"
                                          IsChecked="{Binding IsPickingSectionPlaneFace, Mode=OneWay}" Margin="0,0,6,0"
                                          AutomationProperties.AutomationId="SectionPickFace" />
                            <ToggleButton Content="{res:Loc Section.PickPoints}" ToolTip="{res:Loc Section.PickPoints.Tip}" Command="{Binding SectionAtPointsCommand}"
                                          IsChecked="{Binding IsPickingSectionPoints, Mode=OneWay}"
                                          AutomationProperties.AutomationId="SectionPickPoints" />
                        </WrapPanel>
                        <Button Content="{res:Loc Section.Split}" ToolTip="{res:Loc Section.Split.Tip}" Command="{Binding SplitAtPlaneCommand}"
                                Margin="0,8,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="SectionSplit" />
                    </StackPanel>
                </Border>

                <!-- Measuring tool (E-07): mode, results -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10" Width="300" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource PanelBrush}"
                        Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="MeasurePanel">
                    <StackPanel>
                        <TextBlock Text="{res:Loc Measure.Title}" Style="{StaticResource PanelHeader}" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding MeasureModes}" DisplayMemberPath="Label" SelectedValuePath="Index"
                                  SelectedValue="{Binding MeasureMode}" Margin="0,0,0,8" AutomationProperties.AutomationId="MeasureMode" />
                        <TextBlock Text="{res:Loc Measure.Empty}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Measurements.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Measurements}" AutomationProperties.AutomationId="MeasureResults">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,0,0,3" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Content="{res:Loc Measure.Clear}" Command="{Binding ClearMeasurementsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                AutomationProperties.AutomationId="MeasureClear" />
                    </StackPanel>
                </Border>

                <!-- Edge tool: what the next chamfer or fillet looks like (F-EDG-02) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" Padding="10" Width="260" CornerRadius="4"
                        BorderThickness="1" BorderBrush="{DynamicResource PanelBorderBrush}" Background="{DynamicResource PanelBrush}"
                        Visibility="{Binding IsPlacingEdgeCut, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="EdgePanel">
                    <StackPanel DataContext="{Binding EdgeTool}">
                        <TextBlock Text="{res:Loc Edge.Tool.Title}" Style="{StaticResource PanelHeader}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{res:Loc Edge.Type}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" DisplayMemberPath="Label" SelectedValuePath="Index"
                                      SelectedValue="{Binding EdgeType}" AutomationProperties.AutomationId="EdgeToolType" />
                        </Grid>
                        <ContentControl Content="{Binding Size}" />
                    </StackPanel>
                </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Right: properties -->
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{res:Loc Panel.Properties}" Style="{StaticResource PanelHeader}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Project variables (F-PAR-03): optional, so folded away until they are needed -->
                            <Expander Header="{res:Loc Var.Title}" Margin="0,0,0,10" AutomationProperties.AutomationId="VariablesExpander">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{res:Loc Var.Hint}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding Variables.BuiltInText}" TextWrapping="Wrap" FontSize="11" Margin="0,0,0,6"
                                               Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.AutomationId="BuiltInNote" />
                                    <ItemsControl ItemsSource="{Binding Variables.Rows}" />
                                    <Button Content="{res:Loc Var.Add}" ToolTip="{res:Loc Var.Add.Tip}" Command="{Binding Variables.AddCommand}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.AutomationId="AddVariable" />
                                </StackPanel>
                            </Expander>
                            <TextBlock Text="{Binding PropertiesMessage}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                            <!-- Color (F-VIS-01): any selection; applies to everything inside a group too -->
                            <StackPanel Visibility="{Binding IsColorVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,10"
                                        AutomationProperties.AutomationId="ColorPanel">
                                <TextBlock Text="{res:Loc Panel.Color}" Style="{StaticResource PanelHeader}" />
                                <ItemsControl ItemsSource="{Binding ColorSwatches}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="26" Height="26" Margin="0,0,4,4" Padding="0" MinWidth="0" ToolTip="{Binding Name}"
                                                    AutomationProperties.Name="{Binding Name}"
                                                    Command="{Binding DataContext.ApplyColorCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{Binding Hex}" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1" CornerRadius="3" />
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel Margin="0,4,0,0">
                                    <Border DockPanel.Dock="Left" Width="26" Height="26" CornerRadius="3" BorderThickness="1" Margin="0,0,6,0"
                                            BorderBrush="{DynamicResource PanelBorderBrush}" Background="{Binding ColorPreview}"
                                            AutomationProperties.AutomationId="ColorPreview" />
                                    <TextBlock DockPanel.Dock="Left" Text="#" VerticalAlignment="Center" Margin="0,0,2,0" />
                                    <TextBox Text="{Binding ColorHex, UpdateSourceTrigger=PropertyChanged}" MaxLength="8" ToolTip="{res:Loc Color.Hex.Tip}"
                                             AutomationProperties.AutomationId="ColorHex" AutomationProperties.Name="{res:Loc Color.Hex}" />
                                </DockPanel>
                                <TextBlock Text="{res:Loc Color.Mixed}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           Visibility="{Binding IsColorMixed, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding ColorError}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}"
                                           AutomationProperties.AutomationId="ColorError" />
                            </StackPanel>
                            <ContentControl Content="{Binding Properties}" />
                            <!-- Align and distribute (F-SNP-04): two or more objects are selected -->
                            <StackPanel Visibility="{Binding IsAlignVisible, Converter={StaticResource BoolToVisibility}}" Margin="0,10,0,0"
                                        AutomationProperties.AutomationId="AlignPanel">
                                <TextBlock Text="{res:Loc Align.Title}" Style="{StaticResource PanelHeader}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{res:Loc Align.Min}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{res:Loc Align.Center}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="3" Text="{res:Loc Align.Max}" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Grid.Row="1" Text="X" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Row="1" Grid.Column="1" Content="◧" Command="{Binding AlignCommand}" CommandParameter="X-Min" ToolTip="{res:Loc Menu.Edit.Align.XMin}" Margin="2" MinWidth="0" />
                                    <Button Grid.Row="1" Grid.Column="2" Content="◫" Command="{Binding AlignCommand}" CommandParameter="X-Center" ToolTip="{res:Loc Menu.Edit.Align.XCenter}" Margin="2" MinWidth="0" />
                                    <Button Grid.Row="1" Grid.Column="3" Content="◨" Command="{Binding AlignCommand}" CommandParameter="X-Max" ToolTip="{res:Loc Menu.Edit.Align.XMax}" Margin="2" MinWidth="0" />
                                    <TextBlock Grid.Row="2" Text="Y" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Row="2" Grid.Column="1" Content="⬒" Command="{Binding AlignCommand}" CommandParameter="Y-Min" ToolTip="{res:Loc Menu.Edit.Align.YMin}" Margin="2" MinWidth="0" />
                                    <Button Grid.Row="2" Grid.Column="2" Content="⬓" Command="{Binding AlignCommand}" CommandParameter="Y-Center" ToolTip="{res:Loc Menu.Edit.Align.YCenter}" Margin="2" MinWidth="0" />
                                    <Button Grid.Row="2" Grid.Column="3" Content="⬔" Command="{Binding AlignCommand}" CommandParameter="Y-Max" ToolTip="{res:Loc Menu.Edit.Align.YMax}" Margin="2" MinWidth="0" />
                                    <TextBlock Grid.Row="3" Text="Z" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <Button Grid.Row="3" Grid.Column="1" Content="⊥" Command="{Binding AlignCommand}" CommandParameter="Z-Min" ToolTip="{res:Loc Menu.Edit.Align.ZMin}" Margin="2" MinWidth="0" />
                                    <Button Grid.Row="3" Grid.Column="2" Content="⊢" Command="{Binding AlignCommand}" CommandParameter="Z-Center" ToolTip="{res:Loc Menu.Edit.Align.ZCenter}" Margin="2" MinWidth="0" />
                                    <Button Grid.Row="3" Grid.Column="3" Content="⊤" Command="{Binding AlignCommand}" CommandParameter="Z-Max" ToolTip="{res:Loc Menu.Edit.Align.ZMax}" Margin="2" MinWidth="0" />
                                </Grid>
                                <TextBlock Text="{res:Loc Align.Distribute}" Margin="0,8,0,2" Foreground="{DynamicResource MutedTextBrush}" />
                                <UniformGrid Rows="1" ToolTip="{res:Loc Align.Distribute.Tip}">
                                    <Button Content="X" Command="{Binding DistributeCommand}" CommandParameter="X" Margin="2" MinWidth="0" AutomationProperties.AutomationId="DistributeX" />
                                    <Button Content="Y" Command="{Binding DistributeCommand}" CommandParameter="Y" Margin="2" MinWidth="0" AutomationProperties.AutomationId="DistributeY" />
                                    <Button Content="Z" Command="{Binding DistributeCommand}" CommandParameter="Z" Margin="2" MinWidth="0" AutomationProperties.AutomationId="DistributeZ" />
                                </UniformGrid>
                                <CheckBox Content="{res:Loc Align.ToFirst}" ToolTip="{res:Loc Align.ToFirst.Tip}" IsChecked="{Binding AlignToFirst}" Margin="0,8,0,0"
                                          AutomationProperties.AutomationId="AlignToFirst" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
