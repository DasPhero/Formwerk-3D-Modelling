<Window x:Class="Formwerk.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Formwerk.App.Resources"
        xmlns:views="clr-namespace:Formwerk.App.Views"
        Title="{res:Loc Dlg.SettingsTitle}" SizeToContent="Height" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.Resources>
        <Style x:Key="Num" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinWidth" Value="70" />
            <Setter Property="Margin" Value="0,2,8,2" />
            <Setter Property="ToolTip" Value="{Binding Error}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                    <Setter Property="BorderThickness" Value="1.5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Header" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,12,0,6" />
        </Style>
        <Style x:Key="Err" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20,10,20,20">
        <TextBlock Text="{res:Loc Settings.Project}" Style="{StaticResource Header}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="{res:Loc Settings.BuildVolume}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="BuildXBox" Style="{StaticResource Num}" DataContext="{Binding BuildX}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BuildX" />
                <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Style="{StaticResource Num}" DataContext="{Binding BuildY}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BuildY" />
                <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Style="{StaticResource Num}" DataContext="{Binding BuildZ}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="BuildZ" />
                <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{res:Loc Settings.Preset}" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" x:Name="PresetBox" ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                      SelectionChanged="OnPresetChosen" Margin="0,2,8,2" AutomationProperties.AutomationId="Preset" />

            <TextBlock Grid.Row="2" Text="{res:Loc Settings.Nozzle}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox Style="{StaticResource Num}" DataContext="{Binding Nozzle}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Nozzle" />
                <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{res:Loc Settings.Tolerance}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <TextBox Style="{StaticResource Num}" DataContext="{Binding Tolerance}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Tolerance" />
                <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>
        <CheckBox Content="{res:Loc Settings.UseForNew}" IsChecked="{Binding UseForNewProjects}" Margin="0,6,0,0" AutomationProperties.AutomationId="UseForNew" />
        <TextBlock Text="{res:Loc Settings.ProjectHint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <TextBlock Text="{res:Loc Settings.App}" Style="{StaticResource Header}" Margin="0,18,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock Text="{res:Loc Settings.GridStep}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBox Style="{StaticResource Num}" DataContext="{Binding GridStep}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="GridStep" />
                <TextBlock Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{res:Loc Settings.AngleStep}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBox Style="{StaticResource Num}" DataContext="{Binding AngleStep}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="AngleStep" />
                <TextBlock Text="°" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="{res:Loc Settings.EdgeAngle}" ToolTip="{res:Loc Settings.EdgeAngle.Tip}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                <TextBox Style="{StaticResource Num}" DataContext="{Binding EdgeAngle}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EdgeAngle" />
                <TextBlock Text="°" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="{res:Loc Settings.SnapTolerance}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <TextBox Style="{StaticResource Num}" DataContext="{Binding SnapTolerance}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="SnapTolerance" />
                <TextBlock Text="px" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="4" Text="{res:Loc Settings.Autosave}" VerticalAlignment="Center" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                <TextBox Style="{StaticResource Num}" DataContext="{Binding AutosaveMinutes}" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="Autosave" />
                <TextBlock Text="min" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>

            <TextBlock Grid.Row="5" Text="{res:Loc Settings.Slicer}" VerticalAlignment="Center" />
            <Grid Grid.Row="5" Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding SlicerPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,8,2" AutomationProperties.AutomationId="SlicerPath" />
                <Button Grid.Column="1" Content="{res:Loc Settings.Browse}" Click="OnBrowse" />
            </Grid>
        </Grid>
        <TextBlock Text="{Binding SlicerError}" Style="{StaticResource Err}" Margin="170,0,0,0">
            <TextBlock.Visibility>
                <Binding Path="HasSlicerError">
                    <Binding.Converter>
                        <BooleanToVisibilityConverter />
                    </Binding.Converter>
                </Binding>
            </TextBlock.Visibility>
        </TextBlock>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <CheckBox Content="{res:Loc Snap.Grid}" IsChecked="{Binding SnapToGrid}" Margin="0,0,16,0" />
            <CheckBox Content="{res:Loc Snap.Angle}" IsChecked="{Binding SnapAngles}" Margin="0,0,16,0" />
            <CheckBox Content="{res:Loc Snap.Objects}" IsChecked="{Binding SnapToObjects}" />
        </StackPanel>
        <CheckBox Content="{res:Loc Floor.Keep}" ToolTip="{res:Loc Floor.Keep.Tip}" IsChecked="{Binding AlwaysOnFloor}" Margin="0,8,0,0" />
        <CheckBox Content="{res:Loc Settings.LightTheme}" IsChecked="{Binding LightTheme}" Margin="0,8,0,0" AutomationProperties.AutomationId="SettingsLightTheme" />
        <TextBlock Text="{res:Loc Settings.AppHint}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="{res:Loc Settings.Ok}" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOk"
                    IsEnabled="{Binding IsValid}" AutomationProperties.AutomationId="SettingsOk" />
            <Button Content="{res:Loc Settings.Cancel}" IsCancel="True" MinWidth="90" AutomationProperties.AutomationId="SettingsCancel" />
        </StackPanel>
    </StackPanel>
</Window>
