<Window x:Class="Formwerk.App.Views.ImportUnitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Formwerk.App.Resources"
        Title="{res:Loc Dlg.UnitTitle}" SizeToContent="WidthAndHeight" MinWidth="440" MaxWidth="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Question" TextWrapping="Wrap" Margin="0,0,0,16" />
        <Button x:Name="MillimetersButton" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnChoose" />
        <Button x:Name="CentimetersButton" Margin="0,0,0,8" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnChoose" />
        <Button x:Name="InchesButton" Margin="0,0,0,16" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="OnChoose" />
        <Button Content="{res:Loc Dlg.UnitCancel}" IsCancel="True" HorizontalAlignment="Right" MinWidth="120" />
    </StackPanel>
</Window>
