<Window x:Class="Formwerk.App.Views.TextPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:Formwerk.App.Resources"
        SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Prompt" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="Input" MaxLength="40" Margin="0,0,0,16" AutomationProperties.AutomationId="TextPromptInput" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{res:Loc Settings.Ok}" IsDefault="True" MinWidth="90" Margin="0,0,8,0" Click="OnOk" AutomationProperties.AutomationId="TextPromptOk" />
            <Button Content="{res:Loc Settings.Cancel}" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
